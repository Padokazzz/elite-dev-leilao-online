# Copie para backend/.env (desenvolvimento local).
# Em produção (Render/Neon), configure as mesmas variáveis no painel do
# serviço — nunca suba .env versionado.

# --- Django ---
DEBUG=True
DJANGO_SECRET_KEY=troque-em-producao
# Produção: DEBUG=False e uma chave longa e aleatória por serviço.
ALLOWED_HOSTS=localhost,127.0.0.1
# Produção (PLANO §4.2):
#   ALLOWED_HOSTS=elite-dev-leilao-online.onrender.com
#   CORS_ALLOWED_ORIGINS=https://leilao.vercel.app
#   CSRF_TRUSTED_ORIGINS é derivado de CORS_ALLOWED_ORIGINS no settings.
#   ATENÇÃO: Django não aceita "*.onrender.com" (asterisco no meio não é
#   wildcard) — use host exato ou forma com ponto inicial ".onrender.com".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (Neon em produção) ---
DB_NAME=leilao_online
DB_USER=padoka
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Neon: DB_HOST=<project>-ep-....neon.tech, DB_USER principal,
# DB_PASSWORD do role, DB_NAME neondatabase + SSL por padrão.

# --- Redis (canal do Channels — obrigatório fora de dev) ---
# Desenvolvimento: usa o Redis local; vazio cai no channel layer em
# memória (só serve em dev single-process).
# Produção: REDIS_URL=rediss://... (Upstash/Render com TLS)
REDIS_URL=redis://localhost:6379/0

# --- Auditoria ---
# Pseudônimos HMAC dos licitantes; se vazio, cai no SECRET_KEY.
AUDIT_PSEUDO_SECRET=

# --- Opcionais ---
# Número de proxies à frente da API (X-Forwarded-For) — DRF throttle.
NUM_PROXIES=1
# Teto do limite global de requisições (DRF).
THROTTLE_ANON=120/min
THROTTLE_USER=1200/min
